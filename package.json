{
  "name": "fishbot-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx apps/control-api/src/main.ts",
    "agent": "tsx apps/node-agent/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/control-api/src/main.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:web": "tsx tests/browser.ts",
    "setup:astrbot": "python scripts/setup_astrbot.py",
    "db:migrate": "tsx packages/database/migrate.ts",
    "setup:euler": "python scripts/setup_euler.py",
    "protocol:lab": "tsx scripts/protocol-lab.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "build:production": "tsc --noEmit && node scripts/production-build.mjs",
    "db:migrate:postgres": "tsx scripts/migrate-pglite-postgres.ts",
    "start:production": "node --max-old-space-size=128 scripts/production-start.mjs",
    "check:production": "node scripts/production-check.mjs",
    "setup:napcat": "python scripts/napcat-setup.py",
    "benchmark:shared": "node --max-old-space-size=128 --import tsx experiments/round2-shared/run.ts",
    "db:prepare-template": "tsx scripts/prepare-db-template.ts",
    "docker:prepare": "node scripts/prepare-docker-context.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "proper-lockfile": "4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
