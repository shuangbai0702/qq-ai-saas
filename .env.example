HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
# Empty = persistent embedded PostgreSQL (PGlite); external PostgreSQL supported.
DATABASE_URL=
DATA_ROOT=.local
# Generated on first boot if omitted; keep .local/master.key for decryption.
MASTER_KEY=
ASTRBOT_SOURCE=references/astrbot
ASTRBOT_PYTHON=references/astrbot/.venv/Scripts/python.exe
EULER_SOURCE=references/euler
EULER_PYTHON=references/euler/.venv/Scripts/python.exe
EULER_SIGNER_URL=
EULER_SIGNER_TOKEN=
# NapCat per-bot administrator endpoint mappings: see docs/runtime.md.
# Linux optional delegated cgroup v2 root (not applied on Windows):
FISHBOT_CGROUP_ROOT=
BOT_MEMORY_MAX_BYTES=1073741824
BOT_CPU_MAX=100000 100000

# Compact PostgreSQL buffers; balanced restores upstream PGlite defaults.
DB_MEMORY_PROFILE=compact
# Hosted lazy SDK imports; 0 restores upstream import behavior.
FISHBOT_ASTRBOT_SLIM=1
# Automatic OS-specific idle reclamation; off disables native process advice.
# Linux requires existing Swap + process_madvise permission; never edits sysctl.
FISHBOT_MEMORY_POLICY=auto
